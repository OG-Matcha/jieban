// 網頁正式站：Cloudflare Workers 靜態資源（免費方案）。npm run deploy = 建置 + 上傳 dist/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codefest-mrt",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
